# Copie ce fichier en .env pour le developpement local (jamais commite).
# En production, ces valeurs se saisissent dans Netlify :
#   Site settings > Environment variables
#
# Format : une variable par ligne, CLE=valeur, sans espace autour du =.
# Ne JAMAIS laisser une valeur seule sur une ligne : elle serait interpretee
# comme une commande par les outils qui chargent le fichier.

# --- Chat (fonction /api/chat) ---
OPENROUTER_API_KEY=
OPENROUTER_MODELE=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Formulaire de contact (fonction /api/contact) ---
RESEND_API_KEY=
# Un ou plusieurs destinataires, separes par des virgules (50 maximum).
# Exemple : patrick@nexshield.tg,dora@nexshield.tg,contact@nexshield.tg
CONTACT_TO=
# Expediteur. DOIT appartenir a un domaine verifie chez Resend.
# Sans domaine verifie, utiliser onboarding@resend.dev : les courriels ne
# partiront alors QUE vers l'adresse du compte Resend (mode test).
CONTACT_FROM=

# --- Divers ---
SITE_URL=https://nexshieldsec.netlify.app
